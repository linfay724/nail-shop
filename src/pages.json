{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^u-(.*)": "uview-pro/components/u-$1/u-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "穿戴甲小店"
			}
		},
		{
			"path": "pages/product/list",
			"style": {
				"navigationBarTitleText": "全部商品"
			}
		},
		{
			"path": "pages/product/detail",
			"style": {
				"navigationBarTitleText": "商品详情"
			}
		},
		{
			"path": "pages/cart/index",
			"style": {
				"navigationBarTitleText": "购物车"
			}
		},
		{
			"path": "pages/order/list",
			"style": {
				"navigationBarTitleText": "我的订单"
			}
		},
		{
			"path": "pages/profile/index",
			"style": {
				"navigationBarTitleText": "我的"
			}
		}
	],
	"subPackages": [
		{
			"root": "pages-user",
			"pages": [
				{
					"path": "checkout/index",
					"style": {
						"navigationBarTitleText": "确认订单"
					}
				},
				{
					"path": "order/detail",
					"style": {
						"navigationBarTitleText": "订单详情"
					}
				},
				{
					"path": "aftersale/apply",
					"style": {
						"navigationBarTitleText": "申请售后"
					}
				},
				{
					"path": "address/list",
					"style": {
						"navigationBarTitleText": "收货地址"
					}
				},
				{
					"path": "address/edit",
					"style": {
						"navigationBarTitleText": "编辑地址"
					}
				},
				{
					"path": "favorite/index",
					"style": {
						"navigationBarTitleText": "我的收藏"
					}
				},
				{
					"path": "guide/size",
					"style": {
						"navigationBarTitleText": "尺码测量指引"
					}
				}
			]
		},
		{
			"root": "pages-admin",
			"pages": [
				{
					"path": "auth/index",
					"style": {
						"navigationBarTitleText": "管理端鉴权"
					}
				},
				{
					"path": "index/index",
					"style": {
						"navigationBarTitleText": "管理工作台"
					}
				},
				{
					"path": "product/list",
					"style": {
						"navigationBarTitleText": "商品管理"
					}
				},
				{
					"path": "product/edit",
					"style": {
						"navigationBarTitleText": "编辑商品"
					}
				},
				{
					"path": "craft/edit",
					"style": {
						"navigationBarTitleText": "制作档案"
					}
				},
				{
					"path": "order/list",
					"style": {
						"navigationBarTitleText": "订单管理"
					}
				},
				{
					"path": "order/detail",
					"style": {
						"navigationBarTitleText": "订单处理"
					}
				}
			]
		}
	],
	"preloadRule": {
		"pages/index/index": {
			"network": "all",
			"packages": ["pages-user"]
		}
	},
	"tabBar": {
		"color": "#8c7f7b",
		"selectedColor": "#c98b7a",
		"backgroundColor": "#ffffff",
		"borderStyle": "white",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页",
				"iconPath": "static/tab-home.png",
				"selectedIconPath": "static/tab-home-active.png"
			},
			{
				"pagePath": "pages/product/list",
				"text": "商品",
				"iconPath": "static/tab-product.png",
				"selectedIconPath": "static/tab-product-active.png"
			},
			{
				"pagePath": "pages/cart/index",
				"text": "购物车",
				"iconPath": "static/tab-cart.png",
				"selectedIconPath": "static/tab-cart-active.png"
			},
			{
				"pagePath": "pages/order/list",
				"text": "订单",
				"iconPath": "static/tab-order.png",
				"selectedIconPath": "static/tab-order-active.png"
			},
			{
				"pagePath": "pages/profile/index",
				"text": "我的",
				"iconPath": "static/tab-profile.png",
				"selectedIconPath": "static/tab-profile-active.png"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "穿戴甲小店",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	}
}
